{
	"luci-app-aether-proxy": {
		"description": "Grant access to aether-proxy",
		"read": {
			"ubus": {
				"aetherproxy": [ "version", "status", "events", "job_status" ]
			},
			"uci": [ "aetherproxy" ]
		},
		"write": {
			"ubus": {
				"aetherproxy": [ "service", "check", "job_start" ]
			},
			"uci": [ "aetherproxy" ]
		}
	}
}
