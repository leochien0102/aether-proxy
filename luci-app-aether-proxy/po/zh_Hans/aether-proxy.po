msgstr "阻断 QUIC"

msgid "Hijack DNS"
msgstr "劫持 DNS"

msgid "Filter IPv6"
msgstr "过滤 IPv6"

msgid "Filter HTTPS RR"
msgstr "过滤 HTTPS RR"

msgid "Fail open"
msgstr "故障放行"

msgid "Sniffing"
msgstr "入站嗅探"

msgid "Log level"
msgstr "日志等级"

msgid "Xray log level"
msgstr "Xray 日志等级"

msgid "Boot wait timeout"
msgstr "开机等待时间"

msgid "Boot check targets"
msgstr "开机检测目标"

msgid "Health check URL"
msgstr "健康检测地址"

msgid "Expected status code"
msgstr "期望状态码"

msgid "Health check timeout"
msgstr "健康检测超时"

msgid "Fail threshold"
msgstr "失败阈值"

msgid "Recover threshold"
msgstr "恢复阈值"

msgid "Node probe timeout"
msgstr "节点检测超时"

msgid "Node probe concurrency"
msgstr "节点检测并发数"

