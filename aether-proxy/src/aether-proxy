#!/usr/bin/ucode -S
'use strict';
// CLI entry point: parse arguments and load only the selected subcommand module.
// Design: docs/10「分层」「`aether-proxy` 约定」「按子命令加载模块」.

import * as C from 'aetherproxy.const';

// Keep module names fixed: user input must never become import source code.
const COMMAND_MODULES = {
	check: 'aetherproxy.cmd.check',
	render: 'aetherproxy.cmd.render',
	status: 'aetherproxy.cmd.status',
	components: 'aetherproxy.cmd.components',
	stats: 'aetherproxy.cmd.stats',
	events: 'aetherproxy.cmd.events',
	probe: 'aetherproxy.cmd.probe',
	daemon: 'aetherproxy.cmd.daemon',
	cleanup: 'aetherproxy.cmd.cleanup',
	sub: 'aetherproxy.cmd.sub',
	job: 'aetherproxy.cmd.job',
	update: 'aetherproxy.cmd.update',
	log: 'aetherproxy.cmd.log',
	node: 'aetherproxy.cmd.node',
	custom: 'aetherproxy.cmd.custom',
	data: 'aetherproxy.cmd.data',
};

const USAGE = `Usage: aether-proxy <command> [options]

Commands:
  version [--json]   print the installed version
  check [--json]     validate the configuration and render into staging
  render <name>      print one artifact (xray|nft|chinadns|dnsmasq)
  status [--json]    print the latest runtime state
  components [--json] find installed components and read their versions
  stats [--json]     read traffic and connection counters
  events [options]   list structured events
  probe now          request an immediate proxy health check
  probe nodes        test TCP reachability of subscription nodes
  probe results      print the latest node reachability results
  sub status         read subscription update records
  sub update         download and atomically apply subscriptions
  node import <uri>  import a share-link URI as a manual node
  custom get|set     read or validate-and-save a custom list file
  log [options]      read recent tagged lines from logd
  data status        inspect local rule data and available updates
  update check       check signed package and data updates
  job start          start a long-running command as a background job
  job status         print the state of a background job
  daemon [--boot]    start and supervise proxy components
  cleanup            remove runtime system state
  --help             show this help
`;

function cmd_version(args) {
	if (length(args) == 1 && args[0] == '--json') {
		print(sprintf('%.J', { ok: true, version: C.VERSION }), '\n');
		return 0;
	}

	if (length(args)) {
		warn(USAGE);
		return 2;
	}

	print(`aether-proxy ${C.VERSION}\n`);
	return 0;
}

function main(argv) {
	let cmd = argv[0];

	if (cmd == '--help' || cmd == '-h') {
		print(USAGE);
		return 0;
	}

	// docs/10「`aether-proxy` 约定」: unimplemented subcommands, like unknown ones,
	// are usage errors (USAGE, exit 2), not a separate "not implemented" code.
	if (cmd == 'version')
		return cmd_version(slice(argv, 1));

	let module_name = COMMAND_MODULES[cmd];
	if (module_name != null) {
		// require() cannot load exports on ucode 2025.07.18. Import after dispatch
		// so unrelated modules (including broken ones) do not affect this command.
		let module = loadstring(sprintf("import * as m from '%s'; return m;", module_name))();
		return module.run(slice(argv, 1));
	}

	warn(USAGE);
	return 2;
}

exit(main(ARGV));
