#!/usr/bin/ucode -S
'use strict';

import * as C from 'aetherproxy.const';
import * as check from 'aetherproxy.cmd.check';
import * as render from 'aetherproxy.cmd.render';
import * as status from 'aetherproxy.cmd.status';
import * as events from 'aetherproxy.cmd.events';
import * as probe from 'aetherproxy.cmd.probe';
import * as daemon from 'aetherproxy.cmd.daemon';
import * as cleanup from 'aetherproxy.cmd.cleanup';

const USAGE = `Usage: aether-proxy <command> [options]

Commands:
  version [--json]   print the installed version
  check [--json]     validate the configuration and render into staging
  render <name>      print one artifact (xray|nft|chinadns|dnsmasq)
  status [--json]    print the latest runtime state
  events [options]   list structured events
  probe nodes        test TCP reachability of subscription nodes
  daemon [--boot]    start and supervise proxy components
  cleanup            remove runtime system state
  --help             show this help
`;

function cmd_version(args) {
	if (length(args) == 1 && args[0] == '--json') {
		print(sprintf('%.J', { ok: true, version: C.VERSION }), '\n');
		return 0;
	}

	if (length(args)) {
		warn(USAGE);
		return 2;
	}

	print(`aether-proxy ${C.VERSION}\n`);
	return 0;
}

function main(argv) {
	let cmd = argv[0];

	if (cmd == '--help' || cmd == '-h') {
		print(USAGE);
		return 0;
	}

	// TODO(design): subcommands from docs/10 that are not implemented yet are treated
	// like unknown ones (usage, exit 2); the docs do not define a "not implemented" code.
	if (cmd == 'version')
		return cmd_version(slice(argv, 1));

	if (cmd == 'check')
		return check.run(slice(argv, 1));

	if (cmd == 'render')
		return render.run(slice(argv, 1));

	if (cmd == 'status')
		return status.run(slice(argv, 1));

	if (cmd == 'events')
		return events.run(slice(argv, 1));
	if (cmd == 'probe')
		return probe.run(slice(argv, 1));
	if (cmd == 'daemon')
		return daemon.run(slice(argv, 1));
	if (cmd == 'cleanup')
		return cleanup.run(slice(argv, 1));

	warn(USAGE);
	return 2;
}

exit(main(ARGV));
