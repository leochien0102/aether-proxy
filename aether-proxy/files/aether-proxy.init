#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

AETHER_PROXY=/usr/bin/aether-proxy
_AETHER_PROXY_BOOT=0
# Same name as STOPPED_BY_USER_FILE in lib/const.uc; the directory is overridable for tests.
AETHER_PROXY_RUN_DIR="${AETHER_PROXY_RUN_DIR:-/var/run/aether-proxy}"
_AETHER_PROXY_STOP_MARK="$AETHER_PROXY_RUN_DIR/stopped-by-user"
_AETHER_PROXY_RESTART_INTENT="$AETHER_PROXY_RUN_DIR/restart-intent"
_AETHER_PROXY_RESTARTING=0

start_service() {
	# Any start (manual, restart, reload of a stopped service, boot) clears the manual-stop mark.
	rm -f "$_AETHER_PROXY_STOP_MARK"
	config_load aetherproxy
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	# Register immediately: the daemon publishes starting before doing validation (docs/04).
	procd_open_instance aether-proxy
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param command "$AETHER_PROXY" daemon
	if [ "$_AETHER_PROXY_BOOT" = 1 ]; then
		procd_append_param command --boot
	fi
	procd_set_param respawn 3600 5 5
	# SIGTERM is handled after the synchronous part of a running monitor round (up to ~20 s:
	# curl plus two resolveip), then the orderly stop exports sets, deletes the table and
	# restarts dnsmasq. procd's default 5 s before SIGKILL is far too short; if 30 s still
	# runs out, service_stopped's cleanup does the same steps.
	procd_set_param term_timeout 30
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	_AETHER_PROXY_BOOT=1
	start "$@"
}

restart() {
	config_load aetherproxy
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		stop "$@"
		stop_rc=$?
		[ "$stop_rc" -eq 0 ] || return "$stop_rc"
		start "$@"
		return $?
	fi

	# rc.common restart is stop then start. Publish the volatile intent before stop can
	# signal the old daemon, so its shutdown and service_stopped cleanup retain DNS handoff.
	mkdir -p "$AETHER_PROXY_RUN_DIR" || {
		logger -t aether-proxy "cannot create $AETHER_PROXY_RUN_DIR for restart intent"
		return 1
	}
	intent_tmp="$_AETHER_PROXY_RESTART_INTENT.$$"
	umask 077
	if ! printf 'restart\n' > "$intent_tmp" || ! mv -f "$intent_tmp" "$_AETHER_PROXY_RESTART_INTENT"; then
		logger -t aether-proxy "cannot write $_AETHER_PROXY_RESTART_INTENT"
		rm -f "$intent_tmp" || logger -t aether-proxy "cannot remove $intent_tmp"
		return 1
	fi

	_AETHER_PROXY_RESTARTING=1
	stop "$@"
	stop_rc=$?
	_AETHER_PROXY_RESTARTING=0
	[ "$stop_rc" -eq 0 ] || return "$stop_rc"
	start "$@"
}

service_triggers() {
	procd_add_reload_trigger aetherproxy
}

reload_service() {
	# enabled toggled off: stop; not running yet (toggled on, or start failed earlier): start.
	config_load aetherproxy
	config_get_bool enabled main enabled 0
	if [ "$enabled" != 1 ]; then
		# stop_service writes the manual-stop mark; this stop is not manual, so clear it again.
		procd_running aether-proxy && stop
		rm -f "$_AETHER_PROXY_STOP_MARK"
		return 0
	fi
	if ! procd_running aether-proxy; then
		# Stopped by hand (docs/04): editing the configuration must not bring it back.
		[ -e "$_AETHER_PROXY_STOP_MARK" ] && return 0
		start
		return $?
	fi

	# The daemon validates once and records failures for the node-switch UI (docs/04 reload).
	procd_send_signal aether-proxy '*' HUP
	rc=$?
	if [ "$rc" -ne 0 ]; then
		logger -t aether-proxy "procd_send_signal HUP failed (rc=$rc)"
		return "$rc"
	fi
	return 0
}

stop_service() {
	if [ "$_AETHER_PROXY_RESTARTING" = 1 ]; then
		# restart() already published its stronger intent; do not replace it with a manual stop.
		return 0
	fi

	# Manual stop and enabled=0 must close a failed restart before the daemon is signalled.
	if ! rm -f "$_AETHER_PROXY_RESTART_INTENT"; then
		logger -t aether-proxy "cannot remove $_AETHER_PROXY_RESTART_INTENT"
		return 1
	fi
	mkdir -p "$AETHER_PROXY_RUN_DIR" && : > "$_AETHER_PROXY_STOP_MARK" || {
		logger -t aether-proxy "cannot write $_AETHER_PROXY_STOP_MARK"
		return 1
	}
	return 0
}

service_stopped() {
	# Wait for both the daemon and its lock: monitor mode does not hold the lock (docs/04).
	"$AETHER_PROXY" cleanup --wait 35
	rc=$?
	if [ "$rc" -ne 0 ]; then
		logger -t aether-proxy "aether-proxy cleanup failed (rc=$rc)"
	fi
	# procd's stop deleted the service together with its reload trigger. Register it again with
	# no instance, as boot does when enabled=0, so a later config change still reaches
	# reload_service (docs/04 "配置变化的触发器在停止后也要保留").
	# rc.common (procd) runs stop_service, deletes the service, then service_stopped; procd_close_service
	# adds service_triggers itself, so open + close registers the triggers with no instance.
	procd_open_service "$(basename "${basescript:-${initscript:-aether-proxy}}")" "${initscript:-/etc/init.d/aether-proxy}"
	procd_close_service
	return "$rc"
}
