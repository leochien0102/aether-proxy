#!/bin/sh

log_failure() {
	logger -t aether-proxy-uci-defaults "$1 failed (rc=$2)"
}

current=$(uci -q get aetherproxy.update.data_minute)
rc=$?
if [ "$rc" -eq 0 ] && [ -n "$current" ]; then
	exit 0
fi
if [ "$rc" -ne 1 ] && [ "$rc" -ne 0 ]; then
	log_failure 'uci -q get aetherproxy.update.data_minute' "$rc"
	exit 1
fi

# ucode is a hard dependency; od/hexdump are optional busybox applets and missing on some builds.
random=$(ucode -l fs -e 'let f = fs.open("/dev/urandom"); let b = f.read(2); f.close(); print(ord(b, 0) * 256 + ord(b, 1));')
rc=$?
if [ "$rc" -ne 0 ]; then
	log_failure 'reading /dev/urandom with ucode' "$rc"
	exit 1
fi
case "$random" in
	''|*[!0-9]*)
		logger -t aether-proxy-uci-defaults 'ucode returned an invalid unsigned integer'
		exit 1
		;;
esac
minute=$((random % 60))

uci set "aetherproxy.update.data_minute=$minute"
rc=$?
if [ "$rc" -ne 0 ]; then
	log_failure 'uci set aetherproxy.update.data_minute' "$rc"
	exit 1
fi
uci commit aetherproxy
rc=$?
if [ "$rc" -ne 0 ]; then
	log_failure 'uci commit aetherproxy' "$rc"
	exit 1
fi
exit 0
