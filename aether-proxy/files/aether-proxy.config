config global 'main'
	option enabled '0'
	option mode 'bypass_cn'
	list lan_ifaces 'br-lan'
	option unlisted_policy 'follow'

config dns 'dns'
	list china_dns '223.5.5.5'
	list china_dns '114.114.114.114'
	list trust_dns '8.8.8.8'
	list trust_dns '1.1.1.1'
	list direct_dns 'tcp://9.9.9.9'
	list direct_dns 'tcp://8.8.8.8'

config sub 'sub'
	# TODO(design): docs/05 requires a versioned UA, but packaging only substitutes const.uc.
	# Keep this empty so normalization uses the installed version, not a frozen UA after upgrades.
	option user_agent ''
	option fetch_via 'auto'
	option interval_hours '24'

config update 'update'
	option data_auto '1'
	option xray_auto 'notify'

config probe 'probe'
