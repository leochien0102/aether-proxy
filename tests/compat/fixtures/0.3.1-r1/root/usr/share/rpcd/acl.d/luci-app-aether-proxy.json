{
	"luci-app-aether-proxy": {
		"description": "Grant access to aether-proxy",
		"read": {
			"ubus": {
				"aetherproxy": [
					"version", "status", "events", "job_status", "log", "list_file", "node_parse",
					"probe_results", "sub_status", "data_status", "stats", "components", "probe_sites"
				],
				"luci-rpc": [ "getHostHints" ]
			},
			"uci": [ "aetherproxy" ]
		},
		"write": {
			"ubus": {
				"aetherproxy": [
					"service", "check", "job_start", "node_import", "save_file", "probe_now", "node_use", "mode_use", "probe_url"
				]
			},
			"uci": [ "aetherproxy" ]
		}
	}
}
