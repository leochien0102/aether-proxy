#!/bin/sh
# Version queries must not enter the long-lived DNS service loop.
if [ "$1" = -V ]; then
	printf 'chinadns-ng -V\n' >> "$STUB_LOG"
	if [ -f "$SYSROOT/chinadns-version" ]; then
		cat "$SYSROOT/chinadns-version"
	else
		printf 'ChinaDNS-NG 2025.06.20 be347b5 | fixture\nAdditional banner line\n'
	fi
	exit 0
fi
argv=$*
config=''
while [ $# -gt 0 ]; do
	if [ "$1" = -C ]; then shift; config=$1; break; fi
	shift
done
SYSROOT=${config%/var/run/aether-proxy/current/*}
STUB_LOG="$SYSROOT/calls.log"
printf 'chinadns-ng %s\n' "$argv" >> "$STUB_LOG"
echo "$$" > "$SYSROOT/chinadns.pid"
cleanup() { rm -f "$SYSROOT/chinadns.pid"; exit 0; }
trap cleanup TERM INT
# T9.7 opt-in burst, aligned to a second boundary to make quota assertions deterministic.
if [ -f "$SYSROOT/child-log-lines" ]; then
	read -r lines < "$SYSROOT/child-log-lines"
	awk -v name=chinadns-ng -v lines="$lines" 'BEGIN {
		start = systime(); while (systime() == start) {};
		for (i = 1; i <= lines; i++) printf "%s log %d %d\n", name, systime(), i;
	}'
fi
while :; do sleep 1 & wait $!; done
