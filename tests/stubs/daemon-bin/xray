#!/bin/sh
# Component banner controls stay inside the daemon fixture root (docs/04 versions).
if [ "$1" = version ]; then
	printf 'xray version\n' >> "$STUB_LOG"
	if [ -f "$SYSROOT/xray-version-delay" ]; then sleep 30; fi
	if [ -f "$SYSROOT/xray-version-fail" ]; then
		# A parseable banner with a nonzero exit proves the caller checks the status first.
		printf 'Xray 26.9.30 (Xray, Penetrates Everything.)\n'
		printf 'version query failed\n' >&2
		exit 7
	fi
	if [ -f "$SYSROOT/xray-version" ]; then
		cat "$SYSROOT/xray-version"
	else
		printf 'Xray 26.9.30 (Xray, Penetrates Everything.)\nAdditional banner line\n'
	fi
	exit 0
fi
if [ "$1" = run ] && [ "$2" = -test ]; then
	printf 'xray %s\n' "$*" >> "$STUB_LOG"
	exit "${STUB_XRAY_TEST_RC:-0}"
fi
if [ "$1" = run ] && [ "$2" = -c ]; then
	SYSROOT=${3%/var/run/aether-proxy/current/*}
	STUB_LOG="$SYSROOT/calls.log"
	printf 'xray %s\n' "$*" >> "$STUB_LOG"
	echo "$$" > "$SYSROOT/xray.pid"
	# Like the real Xray (Go): a 0.0.0.0 listener is one dual-stack socket, listed only in tcp6.
	printf '  0: 00000000000000000000000000000000:7968 00000000000000000000000000000000:0000 0A 00000000:00000000 00:00000000 00000000 0 0 0\n' >> "$SYSROOT/proc/net/tcp6"
	cleanup() {
		tmp="$SYSROOT/proc/net/tcp6.tmp"
		grep -v ':7968 0000' "$SYSROOT/proc/net/tcp6" > "$tmp"	# exits 1 when nothing is left; that is fine
		mv "$tmp" "$SYSROOT/proc/net/tcp6"
		rm -f "$SYSROOT/xray.pid"
		exit 0
	}
	trap cleanup TERM INT
	# T9.7 opt-in burst; absent control file preserves every existing fixture's behaviour.
	if [ -f "$SYSROOT/child-log-lines" ]; then
		read -r lines < "$SYSROOT/child-log-lines"
		awk -v name=xray -v lines="$lines" 'BEGIN {
			start = systime(); while (systime() == start) {};
			for (i = 1; i <= lines; i++) printf "%s log %d %d\n", name, systime(), i;
		}'
	fi
	while :; do sleep 1 & wait $!; done
fi
printf 'xray %s\n' "$*" >> "$STUB_LOG"
exit 64
