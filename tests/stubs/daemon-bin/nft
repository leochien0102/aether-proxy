#!/bin/sh
printf 'nft %s\n' "$*" >> "$STUB_LOG"
case " $* " in
	*" -c -f "*)
		# Arm a numbered artifact check only; the precheck kernel probe is separate.
		case "$*" in
			*/aether-proxy.nft)
				# T9.12 review: a measurable artifact check, so two passes must add up.
				if [ -f "$SYSROOT/nft-check-sleep" ]; then sleep 0.3; fi
				if [ -f "$SYSROOT/nft-check-fail-after" ]; then
					read -r left < "$SYSROOT/nft-check-fail-after"
					left=$((left - 1))
					printf '%s\n' "$left" > "$SYSROOT/nft-check-fail-after"
					[ "$left" -eq 0 ] && { echo 'stub artifact validation failure' >&2; exit 1; }
				fi
				;;
		esac
		exit "${STUB_NFT_CHECK_RC:-0}"
		;;
	*" -f "*)
		if [ -f "$SYSROOT/nft-load-fail" ]; then
			echo 'stub armed load failure' >&2
			exit 1
		fi
		if [ "${STUB_NFT_FAIL_ONCE:-0}" = 1 ] && [ ! -e "$SYSROOT/nft-failed-once" ]; then
			touch "$SYSROOT/nft-failed-once"
			echo 'stub nft load fails on the first runtime application' >&2
			exit 1
		fi
		if [ "${STUB_NFT_RC:-0}" -ne 0 ]; then echo 'stub nft load failure' >&2; exit "$STUB_NFT_RC"; fi
		touch "$SYSROOT/nft-table"
		exit 0
		;;
	*" list table inet aetherproxy "*)
		[ -e "$SYSROOT/nft-table" ] && { echo 'table inet aetherproxy'; exit 0; }
		echo 'Error: No such file or directory' >&2; exit 1
		;;
	*" list tables "*) [ -s "$SYSROOT/conflicts" ] && cat "$SYSROOT/conflicts"; exit 0 ;;
	*" -j list set "*)
		for name do :; done
		elem='[]'
		[ "$name" = gfw4 ] && elem="${STUB_GFW4_ELEM:-[]}"	# bare values, as real nft -j prints them
		# Opt-in for a daemon that is already running: live elements appear without a restart.
		[ "$name" = gfw4 ] && [ -f "$SYSROOT/gfw4-elem" ] && elem=$(cat "$SYSROOT/gfw4-elem")
		printf '{"nftables":[{"set":{"name":"%s","elem":%s}}]}\n' "$name" "$elem"
		exit 0
		;;
	*" delete table inet aetherproxy "*) rm -f "$SYSROOT/nft-table"; exit 0 ;;
esac
exit 0
