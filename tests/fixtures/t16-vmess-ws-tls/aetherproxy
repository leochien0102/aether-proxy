config global 'main'
	option enabled '1'
	option mode 'gfw'
	option node 'n_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
	list lan_ifaces 'br-lan'
	option sniffing '1'
	option xray_log_level 'warning'

config dns 'dns'
	list china_dns '223.5.5.5'
	list trust_dns '8.8.8.8'
	list trust_dns '1.1.1.1'

config node 'n_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
	option protocol 'vmess'
	option address 'vm.example.com'
	option port '443'
	option uuid '66666666-7777-4888-8999-aaaaaaaaaaaa'
	option transport 'ws'
	option path '/vm'
	option host 'cdn.example.com'
	option security 'tls'
	option sni 'vm.example.com'
	list alpn 'h2'
	list alpn 'http/1.1'
	option fingerprint 'chrome'
	option pinned_cert_sha256 'aa11,bb22'
	option verify_name 'vm.example.com'
