table inet aetherproxy
delete table inet aetherproxy

table inet aetherproxy {
	set reserved4 { type ipv4_addr; flags interval; auto-merge; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } }
	set node_ip4 { type ipv4_addr; flags interval; auto-merge; }
	set chnroute4 { type ipv4_addr; flags interval; auto-merge; }
	set gfw_static4 { type ipv4_addr; flags interval; auto-merge; }
	set direct_ip4 { type ipv4_addr; flags interval; auto-merge; }
	set proxy_ip4 { type ipv4_addr; flags interval; auto-merge; }
	set gfw4 { type ipv4_addr; flags interval; auto-merge; }  # chinadns-ng add-taggfw-ip
	set udirect4 { type ipv4_addr; flags interval; auto-merge; }  # chinadns-ng group-ipset
	set uproxy4 { type ipv4_addr; flags interval; auto-merge; }  # chinadns-ng group-ipset

	set host_direct4 { type ipv4_addr; flags interval; auto-merge; }
	set host_direct_mac { type ether_addr; }
	set host_proxy4 { type ipv4_addr; flags interval; auto-merge; }
	set host_proxy_mac { type ether_addr; }
	set host_follow4 { type ipv4_addr; flags interval; auto-merge; }
	set host_follow_mac { type ether_addr; }
	set host_udp4 { type ipv4_addr; flags interval; auto-merge; }
	set host_udp_mac { type ether_addr; }

	counter proxy_tx {}
	counter proxy_rx {}
	chain traffic_out {
		type filter hook output priority filter; policy accept;
		ip daddr @node_ip4 counter name proxy_tx
	}
	chain traffic_in {
		type filter hook input priority filter - 2; policy accept;
		ip saddr @node_ip4 counter name proxy_rx
	}
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname != { "br-\\lan", "br-\lan", "br-lan", "eth0.2" } return
		meta nfproto != ipv4 return
		meta l4proto != { tcp, udp } return
		meta l4proto tcp socket transparent 1 meta mark set meta mark | 0x00080000 accept
		fib daddr type local return
		th dport 53 return
		ip daddr @reserved4 return
		ip daddr @node_ip4 return
		ip daddr @direct_ip4 return
		ip daddr @udirect4 return
		jump host_policy
	}

	chain host_policy {
		ip saddr @host_direct4 return
		ether saddr @host_direct_mac return
		ip saddr @host_proxy4 goto proxy
		ether saddr @host_proxy_mac goto proxy
		ip saddr @host_follow4 goto by_mode
		ether saddr @host_follow_mac goto by_mode
	}

	chain by_mode {
		ip daddr @proxy_ip4 goto proxy
		ip daddr @uproxy4 goto proxy
		goto proxy
	}

	chain proxy {
		meta l4proto tcp meta mark set meta mark | 0x00080000 tproxy ip to :31080 accept
		meta l4proto udp ip saddr @host_udp4 meta mark set meta mark | 0x00080000 tproxy ip to :31080 accept
		meta l4proto udp ether saddr @host_udp_mac meta mark set meta mark | 0x00080000 tproxy ip to :31080 accept
		udp dport 443 meta mark set meta mark | 0x00100000
	}

	# reject is not always usable in the prerouting hook (kernel dependent): mark there, reject in forward
	chain quic_reject {
		type filter hook forward priority filter - 1; policy accept;
		meta mark & 0x00100000 == 0x00100000 reject
	}

	# Internal ports are reachable only through TPROXY; direct connections from LAN/WAN are dropped
	chain input_guard {
		type filter hook input priority filter - 1; policy accept;
		iifname "lo" accept
		fib daddr type local th dport { 31080, 31081, 31082, 31083, 31053 } drop
	}

	chain dns_hijack {
		type nat hook prerouting priority dstnat - 5; policy accept;
		iifname != { "br-\\lan", "br-\lan", "br-lan", "eth0.2" } return
		ip saddr @host_direct4 return
		ether saddr @host_direct_mac return
		fib daddr type local return
		meta l4proto { tcp, udp } th dport 53 redirect to :53
	}
}
